# Configuration for the browser sweep. NOT a production configuration.
#
# `scripts/browser-tests.sh` substitutes @PORT@, @CERTIFICATE@, @PRIVATE_KEY@
# and @DATABASE_URL@ and writes the result into a run directory it deletes
# afterwards. Every key is described in docs/configuration.md.
#
# Four differences from deploy/compose/asterius.toml, and each is the point.
#
# `mode = "terminate_tls"` with a certificate generated for the run, rather than
# `behind_proxy` on plain HTTP. The sweep has to prove that a real browser keeps
# the `__Host-` cookie, and the prefix's first guarantee is that the cookie was
# set over a secure origin. Chromium would treat a loopback origin as
# trustworthy anyway, which is exactly why it is not good enough: it would prove
# the cookie survives on the one origin where the rule is relaxed.
#
# `[registration] mode = "open"`, so the harness can register the client it
# needs. An open registration endpoint is a deliberate non-production choice —
# see docs/configuration.md, which explains why the default is to register
# nobody.

log_format = "text"

[server]
bind = "127.0.0.1:@PORT@"
mode = "terminate_tls"

[server.tls]
certificate = "@CERTIFICATE@"
private_key = "@PRIVATE_KEY@"

[database]
url = "@DATABASE_URL@"
max_connections = 8

[keys]
# Development KEK, the same obviously-worthless value the example compose stack
# uses. `head -c 32 /dev/urandom | base64` produces a real one.
kek_env = "ASTERIUS_KEK"

[registration]
mode = "open"

# The deployment administrator (ADR-0010), which the sweep needs for one
# reason: the console's navigation and its routes are role-driven, and every
# fixture until `ast-f7m.6` held `tenant_admin` only. So the *deployment*
# reach — the one that decides whether a screen is shown at all, and the one
# `ast-895` makes conditional on a phishing-resistant authenticator — was
# never exercised in a real browser.
#
# A reserved tenant is a real tenant: it gets an issuer, it is served by the
# same code, and its console is at `/t/e2e-admin/admin/`. It is *not* declared
# as a `[[tenant]]` below — the seed creates and marks it, and declaring it
# twice is refused at load.
#
# `password_env` rather than `password_file`, which the shipped documentation
# prefers: this is a throwaway credential for a throwaway database, and a file
# would be one more thing for the run directory to clean up.
[admin]
tenant = "e2e-admin"
issuer = "https://127.0.0.1:@PORT@/t/e2e-admin"
username = "deployment-admin@example.test"
password_env = "ASTERIUS_ADMIN_PASSWORD"

# The device grant, because the sweep walks its browser half (`ast-ndk.4`).
#
# RFC 8628 §3.3 is a person on a *second* device typing a code into whatever
# browser they have, which is the least likely browser in this server to be
# running script — so the no-JS suite has to be able to reach those pages.
# Everything under `[features]` is off by default and the endpoint is not
# mounted without this, so a sweep that assumed it would meet a 404 and blame
# the flow.
[features]
device_flow = true

# The whole sweep is one address, running flows in parallel as fast as a
# browser can: every test registers its own client and then pushes, redeems and
# reads on behalf of it. Under the shipped defaults that is indistinguishable
# from the abuse `[limits]` exists to stop, and the sweep would fail as a 429
# somewhere in the middle of an unrelated assertion — which is exactly the
# confusing failure to avoid.
#
# So the limits are raised here rather than removed: the sweep's job is to
# prove the flows work in a real browser, and the limiter's own behaviour is
# asserted where it can be asserted precisely, in
# `crates/server/src/http/limits.rs`. A limit that is still a number means a
# runaway loop in a test stops rather than filling a table.
[limits]
registration_per_address = 1000
client_configuration_per_address = 1000
par_per_address = 1000
token_per_address = 1000
userinfo_per_address = 1000

# The issuer is an identifier rather than a fetch target (RFC 8414 §2), but here
# it is also where the browser really goes, so its authority is the address the
# server listens on. `127.0.0.1` and not `localhost`: the sweep must reach the
# same socket the server bound, and a name that may resolve to `::1` first is a
# way for a run to fail for a reason that has nothing to do with the code.
[[tenant]]
id = "e2e"
issuer = "https://127.0.0.1:@PORT@/t/e2e"

# A second tenant, and the only difference that matters is the name in its
# authority (`ast-kb0`).
#
# The RP ID this server derives is the issuer's host with the port removed
# (`crates/server/src/http/passkeys.rs::relying_party`), and an IP literal is
# not a domain: `127.0.0.1` is refused before any authenticator, virtual or
# otherwise, is consulted. So a WebAuthn ceremony cannot run on the tenant
# above — and the tenant above is not the place to fix it, because its address
# was chosen for a reason that still holds. It stays on the literal.
#
# `localhost` rather than a `.test` name: browsers accept it as an RP ID, the
# run certificate already carries it in its SAN, and no resolver has to be
# taught anything. The `::1`-first hazard the note above names is answered
# rather than accepted: Chromium is pinned to the loopback by
# `--host-resolver-rules` in `e2e/playwright.config.ts`, and
# `scripts/browser-tests.sh` will not start the sweep until
# `https://localhost:@PORT@/readyz` has answered — so a name that resolves away
# from the bound socket is a precondition failure with a sentence attached
# rather than a puzzle in an unrelated test.
[[tenant]]
id = "e2e-webauthn"
issuer = "https://localhost:@PORT@/t/e2e-webauthn"
