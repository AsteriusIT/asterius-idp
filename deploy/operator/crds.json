                  "spec"
                ]
              }
            },
            "additionalPrinterColumns": [
              {
                "name": "Ready",
                "type": "string",
                "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status"
              },
              {
                "name": "Generation",
                "type": "integer",
                "jsonPath": ".status.observedGeneration"
              }
            ]
          }
        ]
      }
    }
  ]
}
