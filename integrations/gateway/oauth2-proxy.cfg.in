# Native OAuth2 Proxy; all secrets are deployment-provided private files.
provider = "oidc"
http_address = "0.0.0.0:4180"
redirect_url = "${GATEWAY_ORIGIN}/oauth2/callback"
oidc_issuer_url = "${ASTERIUS_ISSUER}"
client_id = "${ASTERIUS_CLIENT_ID}"
client_secret_file = "/cfg/client.secret"
cookie_secret_file = "/cfg/cookie.secret"
provider_ca_files = ["/cfg/ca.pem"]
authenticated_emails_file = "/cfg/allowed-emails"
code_challenge_method = "S256"
insecure_oidc_skip_nonce = false
insecure_oidc_skip_issuer_verification = false
insecure_oidc_allow_unverified_email = false
scope = "openid email"
upstreams = ["http://backend:8080/"]
reverse_proxy = true
trusted_proxy_ips = ["${EXACT_EDGE_PROXY_IP}/32"]
trusted_ips = []
cookie_name = "__Host-asterius_gateway"
cookie_secure = true
cookie_httponly = true
cookie_path = "/"
cookie_samesite = "lax"
cookie_expire = "30s"
cookie_refresh = "0s"
session_cookie_minimal = true
pass_user_headers = true
pass_basic_auth = false
pass_access_token = false
pass_authorization_header = false
set_authorization_header = false
set_xauthrequest = false
skip_auth_strip_headers = true
skip_jwt_bearer_tokens = false
skip_auth_preflight = false
skip_auth_routes = []
api_routes = ["^/api/.*$"]
skip_provider_button = true
auth_logging = false
request_logging = false
standard_logging = true
