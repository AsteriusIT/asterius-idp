# Copy to `.env` for local development. `.env` is gitignored.
#
# sqlx's compile-time query checking reads DATABASE_URL from here, and so does
# `sqlx migrate run`. Set SQLX_OFFLINE=true instead to build against the
# committed .sqlx/ query data with no database running.
DATABASE_URL=postgres://asterius:asterius@127.0.0.1:5433/asterius
