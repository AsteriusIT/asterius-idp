  "query": "select kid, alg, purpose, state, public_jwk, created_at\n             from signing_keys\n             where tenant_id = $1 and state in ('pending', 'active', 'retiring')\n             order by case state when 'active' then 0 when 'pending' then 1 else 2 end,\n                      created_at desc, kid",
