  "query": "select kid, alg, purpose, state, public_jwk, created_at\n             from signing_keys\n             where tenant_id = $1\n             order by alg,\n                      case state when 'active' then 0 when 'pending' then 1\n                                 when 'retiring' then 2 else 3 end,\n                      created_at desc, kid",
