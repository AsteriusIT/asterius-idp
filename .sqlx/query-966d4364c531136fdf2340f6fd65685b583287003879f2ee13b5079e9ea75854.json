  "query": "select u.user_id, c.password_hash, u.status, c.disabled_at\n               from users u\n               join credentials c\n                 on c.tenant_id = u.tenant_id and c.user_id = u.user_id\n              where u.tenant_id = $1 and u.username = $2 and c.kind = 'password'",
