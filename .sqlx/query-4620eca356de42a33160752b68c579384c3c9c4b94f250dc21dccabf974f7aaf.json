  "query": "select user_id, username, email, email_verified, status, claims,\n                    created_at, updated_at\n             from users\n             where tenant_id = $1\n               and ($2 = '' or username ilike $3 or email ilike $3)\n               and ($4::text is null or username > $4)\n             order by username\n             limit $5",
