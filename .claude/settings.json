{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "Agent",
      "Bash(cargo check*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo nextest*)",
      "Bash(cargo build*)",
      "Bash(cargo add*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git branch*)",
      "Bash(git worktree*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(gh pr*)",
      "Bash(gh run*)",
      "Bash(bd *)",
      "Bash(jq *)",
      "Bash(ls*)",
      "Bash(cat*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(cargo test*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cargo-check.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/grind-stop.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
