{
  "alias": "asterius",
  "description": "Asterius, FAPI 2.0 Security Profile Final, private_key_jwt + DPoP",
  "server": {
    "discoveryUrl": "https://asterius:9443/t/conformance/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "conformance-client-1",
    "scope": "openid profile email offline_access",
    "jwks": {
      "keys": [
        {
          "kty": "EC",
          "crv": "P-256",
          "kid": "conformance-client-1",
          "alg": "ES256",
          "use": "sig",
          "x": "MA2eNkmY5sAXSu-SBFYtznr7228gOHu8EF8bYJddq6Y",
          "y": "jCfP8-emWtbbtfS9XxDl_FLNKD6TphE2qsebEo7jEYY",
          "d": "iObW5Ro96H_ifwDWjeIxKtX4ep4EUUombiwQzQYtb0o"
        }
      ]
    }
  },
  "client2": {
    "client_id": "conformance-client-2",
    "scope": "openid profile email offline_access",
    "jwks": {
      "keys": [
        {
          "kty": "EC",
          "crv": "P-256",
          "kid": "conformance-client-2",
          "alg": "ES256",
          "use": "sig",
          "x": "dwNPa4IWhiZPjqSB79dLv-s9xKC_cU9xg8hK6S9WUbM",
          "y": "zciohqTxZ-Ts3_sU93yA6wzcTIOqz9Q1sDAz_ZZOvIQ",
          "d": "U3Zq-kvZT-PbGYXzI-VcjekhbpYoBazMEfsOH7vQrqQ"
        }
      ]
    }
  },
  "resource": {
    "resourceUrl": "https://asterius:9443/t/conformance/userinfo"
  },
  "browser": [
    {
      "comment": "The nominal browser leg: sign in, allow, and let the callback page post itself back to the suite.",
      "match": "https://asterius:9443/t/conformance/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://asterius:9443/t/conformance/interaction/*",
          "commands": [
            ["text", "name", "username", "conformance@example.test", "optional"],
            ["text", "name", "password", "correct horse battery staple", "optional"],
            ["click", "xpath", "//form//button[@type='submit']"]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "https://asterius:9443/t/conformance/interaction/*",
          "commands": [
            ["click", "xpath", "//button[@name='decision' and @value='allow']"]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "https://localhost.emobix.co.uk:8443/test/a/asterius/callback*",
          "commands": [
            ["wait", "id", "submission_complete", 10]
          ]
        }
      ]
    }
  ],
  "override": {
    "fapi2-security-profile-final-ensure-unsigned-authorization-request-without-using-par-fails": {
      "browser": [
        {
          "comment": "The request never reaches a redirect_uri the server may use, so it ends on the error page; the screenshot is what the module waits for.",
          "match": "https://asterius:9443/t/conformance/authorize*",
          "tasks": [
            {
              "task": "Error page",
              "match": "https://asterius:9443/t/conformance/authorize*",
              "commands": [
                ["wait", "xpath", "//p[@class='error']", 10, ".+", "update-image-placeholder"]
              ]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-reuse-request_uri": {
      "browser": [
        {
          "comment": "One nominal leg, then a second visit with the spent request_uri which ends on the error page.",
          "match": "https://asterius:9443/t/conformance/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["text", "name", "username", "conformance@example.test", "optional"],
                ["text", "name", "password", "correct horse battery staple", "optional"],
                ["click", "xpath", "//form//button[@type='submit']"]
              ]
            },
            {
              "task": "Consent",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["click", "xpath", "//button[@name='decision' and @value='allow']"]
              ]
            },
            {
              "task": "Error page",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/authorize*",
              "commands": [
                ["wait", "xpath", "//p[@class='error']", 10, ".+", "update-image-placeholder"]
              ]
            },
            {
              "task": "Verify Complete",
              "optional": true,
              "match": "https://localhost.emobix.co.uk:8443/test/a/asterius/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-to-use-expired-request_uri": {
      "browser": [
        {
          "comment": "The request_uri has expired before the browser is sent, so the visit ends on the error page.",
          "match": "https://asterius:9443/t/conformance/authorize*",
          "tasks": [
            {
              "task": "Error page",
              "match": "https://asterius:9443/t/conformance/authorize*",
              "commands": [
                ["wait", "xpath", "//p[@class='error']", 10, ".+", "update-image-placeholder"]
              ]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-attempt-to-use-request_uri-for-different-client": {
      "browser": [
        {
          "comment": "One nominal leg with the first client, then the second client presents the same request_uri and lands on the error page.",
          "match": "https://asterius:9443/t/conformance/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["text", "name", "username", "conformance@example.test", "optional"],
                ["text", "name", "password", "correct horse battery staple", "optional"],
                ["click", "xpath", "//form//button[@type='submit']"]
              ]
            },
            {
              "task": "Consent",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["click", "xpath", "//button[@name='decision' and @value='allow']"]
              ]
            },
            {
              "task": "Error page",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/authorize*",
              "commands": [
                ["wait", "xpath", "//p[@class='error']", 10, ".+", "update-image-placeholder"]
              ]
            },
            {
              "task": "Verify Complete",
              "optional": true,
              "match": "https://localhost.emobix.co.uk:8443/test/a/asterius/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-par-ensure-reused-request-uri-prior-to-auth-completion-succeeds": {
      "browser": [
        {
          "comment": "First visit: the login page is looked at and left alone. The module fails the test if anyone signs in here, so this block is spent after one match and the next one takes the second visit.",
          "match": "https://asterius:9443/t/conformance/authorize*",
          "match-limit": 1,
          "tasks": [
            {
              "task": "Initial visit, no login",
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["wait", "name", "username", 10]
              ]
            }
          ]
        },
        {
          "comment": "Second visit with the same request_uri: this is the one that signs in.",
          "match": "https://asterius:9443/t/conformance/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["text", "name", "username", "conformance@example.test", "optional"],
                ["text", "name", "password", "correct horse battery staple", "optional"],
                ["click", "xpath", "//form//button[@type='submit']"]
              ]
            },
            {
              "task": "Consent",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["click", "xpath", "//button[@name='decision' and @value='allow']"]
              ]
            },
            {
              "task": "Error page",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/authorize*",
              "commands": [
                ["wait", "xpath", "//p[@class='error']", 10, ".+", "update-image-placeholder-optional"]
              ]
            },
            {
              "task": "Verify Complete",
              "optional": true,
              "match": "https://localhost.emobix.co.uk:8443/test/a/asterius/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    },
    "fapi2-security-profile-final-user-rejects-authentication": {
      "browser": [
        {
          "comment": "The one test where the person refuses: sign in, then press Deny on the consent screen so the client gets access_denied.",
          "match": "https://asterius:9443/t/conformance/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["text", "name", "username", "conformance@example.test", "optional"],
                ["text", "name", "password", "correct horse battery staple", "optional"],
                ["click", "xpath", "//form//button[@type='submit']"]
              ]
            },
            {
              "task": "Deny",
              "optional": true,
              "match": "https://asterius:9443/t/conformance/interaction/*",
              "commands": [
                ["click", "xpath", "//button[@name='decision' and @value='deny']", "optional"]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "https://localhost.emobix.co.uk:8443/test/a/asterius/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    }
  }
}
