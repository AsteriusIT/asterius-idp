
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Rust
/target/
**/*.rs.bk

# Local environment
.env

# cargo-fuzz
/fuzz/target/
/fuzz/artifacts/
# The corpus a run grows is a cache, carried between nightly runs by
# actions/cache and not worth a diff. The inputs that once *crashed* a target
# are not: they are the regression suite, and a cache that expires is no place
# to keep one. Those are committed, per target, by hand.
/fuzz/corpus/*
!/fuzz/corpus/claims_request/
# Un-ignoring the directory would carry every input a run grew with it,
# so re-ignore its contents and keep only the crashes back.
/fuzz/corpus/claims_request/*
!/fuzz/corpus/claims_request/crash-*

# Subagent worktrees live inside the repo; they are separate checkouts,
# never content.
.claude/worktrees/
.claude/grind.local.json
