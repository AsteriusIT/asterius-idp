
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Rust
/target/
**/*.rs.bk

# Local environment
.env

# The console's toolchain and its output. `console/dist` is embedded into the
# binary by crates/admin-api/build.rs and is rebuilt by
# ./scripts/build-console.sh; committing a bundle would be committing a
# compiler's output. `package-lock.json` *is* committed.
node_modules/
/console/dist/

# cargo-fuzz
/fuzz/target/
/fuzz/artifacts/
# The corpus a run grows is a cache, carried between nightly runs by
# actions/cache and not worth a diff. The inputs that once *crashed* a target
# are not: they are the regression suite, and a cache that expires is no place
# to keep one. Those are committed, per target, by hand.
/fuzz/corpus/*
!/fuzz/corpus/claims_request/
# Un-ignoring the directory would carry every input a run grew with it,
# so re-ignore its contents and keep only the crashes back.
/fuzz/corpus/claims_request/*
!/fuzz/corpus/claims_request/crash-*
!/fuzz/corpus/logout_request/
/fuzz/corpus/logout_request/*
!/fuzz/corpus/logout_request/crash-*
!/fuzz/corpus/redaction_scan/
/fuzz/corpus/redaction_scan/*
!/fuzz/corpus/redaction_scan/crash-*
!/fuzz/corpus/pkce/
/fuzz/corpus/pkce/*
!/fuzz/corpus/pkce/crash-*
!/fuzz/corpus/admin_fetch_metadata/
/fuzz/corpus/admin_fetch_metadata/*
!/fuzz/corpus/admin_fetch_metadata/crash-*
!/fuzz/corpus/admin_cursor/
/fuzz/corpus/admin_cursor/*
!/fuzz/corpus/admin_cursor/crash-*
!/fuzz/corpus/login_bucket/
/fuzz/corpus/login_bucket/*
!/fuzz/corpus/login_bucket/crash-*
!/fuzz/corpus/refresh_token_scope/
/fuzz/corpus/refresh_token_scope/*
!/fuzz/corpus/refresh_token_scope/crash-*
!/fuzz/corpus/dpop_proof/
/fuzz/corpus/dpop_proof/*
!/fuzz/corpus/dpop_proof/crash-*
!/fuzz/corpus/admin_stream_status/
/fuzz/corpus/admin_stream_status/*
!/fuzz/corpus/admin_stream_status/crash-*
!/fuzz/corpus/request_object_claims/
/fuzz/corpus/request_object_claims/*
!/fuzz/corpus/request_object_claims/crash-*

# Subagent worktrees live inside the repo; they are separate checkouts,
# never content.
.claude/worktrees/
.claude/grind.local.json

# The OIDF conformance harness: a third-party checkout and per-run material
# (certificate, truststore, reports). Both are caches of things the harness can
# recreate; neither is content. See conformance/README.md.
/conformance/.suite/
/conformance/.run/

# The example stack's TLS material, generated at first start by
# deploy/scripts/gen-self-signed.sh. A committed private key is a private key
# everyone who clones this repository has, even a development one — and a
# committed certificate is one that expires in a checkout nobody rebuilt.
/deploy/certs/

# Load-test material (scripts/load/gen-keys.sh): a private key, even a load one,
# is not content.
/scripts/load/client-key.der
/scripts/load/client.jwks.json

/scripts/load/certs/
/scripts/load/explain.out
