{
  "components": {
    "parameters": {
      "cursor": {
        "description": "An opaque cursor from a previous response's next_cursor. Not a row key: its shape may change.",
        "in": "query",
        "name": "cursor",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "limit": {
        "description": "Rows per page. Clamped to the server maximum.",
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "schemas": {
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "A closed vocabulary a client may switch on.",
                "type": "string"
              },
              "message": {
                "description": "For a person reading a log. Never carries a credential or a session identifier.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Page": {
        "properties": {
          "items": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass back as `cursor` for the next page. Null on the last page; always present, so a client may loop on it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "adminToken": {
        "description": "A DPoP-bound access token (RFC 9449 §7.1), presented with a DPoP proof header. Token calls are not subject to the CSRF check and are subject to the proof instead.",
        "scheme": "DPoP",
        "type": "http"
      },
      "consoleSession": {
        "description": "The first-party session cookie (ADR-0009). Every state-changing request must also carry X-CSRF-Token, whose value is the `csrf_token` of GET /admin/api/v1/session.",
        "in": "cookie",
        "name": "__Host-asterius_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The first-party administration API. Two authentication modes: the console, which is a same-origin application holding the IdP session cookie and no OAuth token of any kind (ADR-0009); and automation, which holds a DPoP-bound access token. Every operation declares the authority it requires in x-asterius-reach and x-asterius-scope, taken from the same declaration the router enforces. State-changing operations are never mounted on GET: SameSite=Lax does not protect a top-level GET, so the registry's types make a mutating GET unexpressible.",
    "title": "Asterius Admin API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/api/v1/openapi.json": {
      "get": {
        "operationId": "openapi.read",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The operation succeeded."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No credential, or one that no longer resolves."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Authenticated, without the declared authority — or, for the console, without this session's X-CSRF-Token."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A rate limit was reached. Retry-After says when."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Something below the API failed."
          }
        },
        "security": [
          {
            "consoleSession": []
          },
          {
            "adminToken": [
              "admin.openapi:read"
            ]
          }
        ],
        "summary": "This API's OpenAPI 3.1 description",
        "x-asterius-reach": "authenticated",
        "x-asterius-scope": "admin.openapi:read"
      }
    },
