{
  "apiVersion": "apiserver.config.k8s.io/v1",
  "kind": "AuthenticationConfiguration",
  "jwt": [{
    "issuer": {"url": "https://issuer.example/t/demo", "audiences": ["cluster-a-client"], "audienceMatchPolicy": "MatchAny"},
    "claimValidationRules": [
      {"expression": "claims.exp - claims.iat <= 300", "message": "ID token lifetime must not exceed five minutes"},
      {"expression": "type(claims.aud) == string", "message": "one cluster audience is required"}
    ],
    "claimMappings": {
      "username": {"claim": "sub", "prefix": "asterius:demo:cluster-a:"},
      "groups": {"claim": "group_ids", "prefix": "asterius:demo:cluster-a:group:"}
    },
    "userValidationRules": [{
      "expression": "!user.username.startsWith('system:') && user.groups.all(g, !g.startsWith('system:'))",
      "message": "reserved Kubernetes identities are forbidden"
    }]
  }]
}
